# CLEAR Production Environment Variables
# For https://clear.ucu-dct.org

# Django Settings
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=clear.ucu-dct.org,localhost,127.0.0.1,backend

# CORS/CSRF (must match your domain)
CORS_ALLOWED_ORIGINS=https://clear.ucu-dct.org
CSRF_TRUSTED_ORIGINS=https://clear.ucu-dct.org

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ML/CV Configuration
CLEAR_DEVICE=auto
CLEAR_FIELD_PASSWORD=

# Frontend WebSocket URL (for client-side connections)
NEXT_PUBLIC_WS_URL=wss://clear.ucu-dct.org/ws
