# CLEAR Frontend Environment Variables
# Copy this file to .env.local

# Backend URLs (used by Next.js rewrites)
BACKEND_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000

# Public URLs (empty = use proxy, or set full URL for direct access)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8000
