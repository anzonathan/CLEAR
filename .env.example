# CLEAR Environment Variables
# Copy this file to .env and fill in the values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
POSTGRES_DB=clear
POSTGRES_USER=clear
POSTGRES_PASSWORD=clear_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (for Django Channels)
REDIS_HOST=localhost

# CORS/CSRF Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8443
CSRF_TRUSTED_ORIGINS=http://localhost:8443

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ML/CV Configuration
CLEAR_DATA_DIR=/data
CLEAR_RESULTS_DIR=/data/results
CLEAR_CALIB_PATH=/data/calib/session.json
CLEAR_YOLO_WEIGHTS=
CLEAR_DEVICE=auto

# Field Camera Authentication (optional)
CLEAR_FIELD_PASSWORD=

# Frontend
BACKEND_URL=http://backend:8000
BACKEND_WS_URL=ws://backend:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8000
